      "roundness": null,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "how refcnt moves",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "how refcnt moves",
      "lineHeight": 1.25,
      "baseline": 12
    },
    {
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "id": "el69",
      "x": 80,
      "y": 718,
      "width": 530,
      "height": 178,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "seed": 69,
      "version": 1,
      "versionNonce": 75,
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "BeginRo:  v = visible.Load(); v.refcnt.Add(+1)   // pin newest\n\npublish:  old.retired = subsumed; old.next = new\n          visible.Store(new)                    // A -> superseded\n\nClose:    if v.refcnt.Add(-1) == 0 { reclaim() } // maybe last one\n\nreclaim:  for h=oldest; h!=current && h.refcnt==0; h=h.next {\n              closeFilesAndRemove(h.retired)      // <- real delete\n              oldest = h.next\n          }",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BeginRo:  v = visible.Load(); v.refcnt.Add(+1)   // pin newest\n\npublish:  old.retired = subsumed; old.next = new\n          visible.Store(new)                    // A -> superseded\n\nClose:    if v.refcnt.Add(-1) == 0 { reclaim() } // maybe last one\n\nreclaim:  for h=oldest; h!=current && h.refcnt==0; h=h.next {\n              closeFilesAndRemove(h.retired)      // <- real delete\n              oldest = h.next\n          }",
      "lineHeight": 1.25,
      "baseline": 10
    },
