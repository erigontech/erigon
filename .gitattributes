# Auto detect text files and perform LF normalization
* text=auto
*.txt text eol=lf
# Force LF so hashFiles('go.sum') produces consistent CI cache keys across OSes
go.sum text eol=lf
*.sol linguist-language=Solidity

.github/workflows/*.lock.yml linguist-generated=true merge=ours
# Keep the embedded KZG trusted setup byte-identical on every OS; its sha256 is pinned in a test.
common/crypto/kzg/trusted_setup.json text eol=lf
